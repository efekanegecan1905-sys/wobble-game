    m_Metadata:
      m_Items: []
  - m_Id: 1186554961925
    m_Localized: "{0}. G\xDCN"
    m_Metadata:
      m_Items:
      - rid: 5129602412806930432
  - m_Id: 1186554961926
    m_Localized: "Her g\xFCn k\xFC\xE7\xFCk bir hediye. Yedi g\xFCnde bir yeniden
      ba\u015Flar."
    m_Metadata:
      m_Items: []
  - m_Id: 1186554961927
    m_Localized: "Yeni g\xFCn UTC gece yar\u0131s\u0131nda ba\u015Flar. \u015Eimdilik
