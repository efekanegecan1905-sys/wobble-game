      m_Items: []
  - m_Id: 1186550767658
    m_Localized: "BA\u015ELANGI\xC7 PAKET\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1186550767659
    m_Localized: REKLAMLARI KALDIR
    m_Metadata:
      m_Items: []
  - m_Id: 1186550767660
    m_Localized: "Gelecekte reklams\u0131z deneyim"
    m_Metadata:
      m_Items: []
  - m_Id: 1186550767661
    m_Localized: "\xD6n izleme fiyatlar\u0131d\u0131r. Sat\u0131n alma hen\xFCz a\xE7\u0131k
      de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 1186554961920
    m_Localized: "Bu \xFCr\xFCn hen\xFCz sat\u0131\u015Fta de\u011Fil. \xD6deme al\u0131nmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 1186554961921
    m_Localized: "\xD6zel g\xF6r\xFCn\xFCm daha sonra eklenecek. Sat\u0131n alma
      hen\xFCz a\xE7\u0131k de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 1186554961922
    m_Localized: "G\xDCNL\xDCK \xD6D\xDCL"
